<Project Sdk="Microsoft.NET.Sdk">

  <!-- The vocabulary two Pegasus programs have to agree on: the wire types, the
       frame encoding, the sealed envelope, and identity keys.

       This exists because EmuSen.Chariot, the server, has to speak the same
       protocol as the desktop application, and the alternative was two
       implementations of a frame format kept in step by hand.

       docs/Pegasus_Design.md §7 collapsed Pegasus to one assembly on the rule
       that a project boundary has to buy somebody separability they are
       actually using. Chariot is that somebody, so this satisfies the rule
       rather than breaking it, and docs/Pegasus_Design.md §7 was rewritten when
       this landed rather than left contradicting the tree.

       DEPENDENCIES: none, deliberately, and a test asserts it. No YDotNet,
       because nothing here merges a document — Chariot is a router and a
       mailbox: Chariot_Design.md §4, in the EmuSen.Chariot repository. No Avalonia, because a server
       has no window. Anything added here is carried by every consumer, so a
       PackageReference in this file is a decision about Chariot too. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EmuSen.Pegasus.Core</AssemblyName>
    <RootNamespace>EmuSen.Pegasus</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Packed for EmuSen.Chariot, which lives in another repository and cannot
         resolve a ProjectReference. In THIS repository the application takes a
         ProjectReference instead, so there is no packing step between editing a
         frame and running the tests: the package exists for the consumer that
         cannot see the source, the project reference for the one that can.
         docs/Pegasus_Design.md §7.1.

         Published to nuget.org from a `core-v*` tag by .github/workflows/
         publish-core.yml, which holds no credential — NuGet Trusted Publishing
         exchanges a GitHub OIDC token for a key good for minutes. The version
         below is only the default for a local `dotnet pack`; the published one
         comes from the tag, so it cannot be written in two places and disagree
         with itself. -->
    <IsPackable>true</IsPackable>
    <PackageId>EmuSen.Pegasus.Core</PackageId>
    <!-- 0.2.0 was the real bump. Protocol went from 3 to 4, the Agree frame and
         the Agreement module arrived with the key agreement, and Chariot is on
         the InternalsVisibleTo list because a server that signs needs somewhere
         to keep a key. A consumer on 0.1.0 cannot talk to one on 0.2.0 — Hello
         says so in the first frame rather than letting it be discovered as a
         decode failure further down.

         0.2.1 and 0.2.2 carry no protocol change at all. They are the two
         attempts at the FSharp.Core pin below, and only the second one held;
         what went wrong in between is worth reading before touching that pin.
         Both earlier versions remain resolvable on nuget.org and both emit an
         NU1605 downgrade at any consumer holding FSharp.Core 10.0.110.

         0.3.0 carries no protocol change either. It is the relicence to MIT
         (§14), and it is a bump because a licence is the one thing a consumer
         most needs a version to signal and there is no other mechanism for
         signalling it. Protocol stays at 4: a 0.2.x peer and a 0.3.0 peer talk
         to each other exactly as they did. -->
    <Version>0.3.0</Version>
    <Authors>Tristan Pelland</Authors>
    <Description>Wire types, frame codec, sealed envelope and identity keys shared by Pegasus and Chariot.</Description>
    <!-- MIT as of 0.3.0; 0.2.0-0.2.2 shipped GPL-3.0-or-later and stay that way
         on nuget.org, which cannot edit a published package's metadata. The GPL
         was never chosen here - it was inherited from LunaP, which has since
         relicensed, and every dependency of this package is permissive. §14. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/RedQuE3n/EmuSen.Pegasus</RepositoryUrl>
    <PackageTags>crdt;protocol;fsharp;pegasus</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- FSharp.Core pinned rather than left implicit, and this was found the
         hard way: the SDK adds it automatically at whatever version that SDK
         ships, so the PUBLISHED package declared a floor of 10.1.302 when built
         by a CI runner and 10.0.110 when built here. The artifact varied by who
         built it, which is not a property a package may have — and the first
         consumer to notice was Chariot, with a NU1605 downgrade warning against
         a package it had just been told to trust.

         Pinned LOW on purpose. A floor is a demand on every consumer, and
         nothing here uses anything newer; a consumer on a later SDK satisfies
         >= 10.0.110 with the version it already has, while the reverse would
         force an upgrade for no reason.

         This is still the core's ONE dependency, which is the rule the test in
         CoreTests asserts. Pinning it changes the version, not the count.

         DisableImplicitFSharpCoreReference IS THE LOAD-BEARING HALF, and the
         first attempt at this pin shipped without it. The F# SDK does not skip
         its implicit reference when it finds an explicit one - it adds a second
         PackageReference for the same id (Microsoft.FSharp.NetSdk.props, and
         the condition there is on this property alone), and NuGet resolves two
         entries by taking the higher. On this machine both were 10.0.110 so the
         pin looked like it worked; on a runner whose SDK ships 10.1.302 the
         implicit one won and 0.2.1 published with exactly the floor 0.2.0 had.
         A pin that only holds where the two versions already agree is not a
         pin. -->
    <PackageReference Include="FSharp.Core" Version="10.0.110" />
  </ItemGroup>

  <PropertyGroup>
    <!-- A property, not an item, and it belongs beside the reference above -
         see the comment there for why it is the half that matters. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- Identity.OfPrivateKey and ExportPrivateKey are internal because nothing
         outside an identity store's own read and write path has business with a
         private key. The desktop store lives in the application and the guard
         asserting the key never reaches disk unsealed lives in the tests, so
         both need to see in.

         CORRECTION. This list used to end "Chariot deliberately gets neither:
         it verifies signatures", and that stopped being true when Chariot got
         an identity of its own and started signing challenges with it — a
         server that cannot prove itself is a server anyone holding the
         passphrase can impersonate, which is Chariot_Design.md §9.2. Chariot
         therefore has an identity store, which is the condition for being on
         this list rather than an exception to it. It still holds no client's
         private key and never will. -->
    <InternalsVisibleTo Include="EmuSen.Pegasus" />
    <InternalsVisibleTo Include="EmuSen.Pegasus.Tests" />
    <InternalsVisibleTo Include="EmuSen.Chariot" />
    <InternalsVisibleTo Include="EmuSen.Chariot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Crypto.fs" />
    <Compile Include="Identity.fs" />
    <Compile Include="Attestation.fs" />
    <Compile Include="Agreement.fs" />
    <Compile Include="Framing.fs" />
    <Compile Include="Handshake.fs" />
  </ItemGroup>

</Project>
