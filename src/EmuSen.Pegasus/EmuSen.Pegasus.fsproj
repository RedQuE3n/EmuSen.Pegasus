<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pegasus: a live shared notepad two people type into at once. Named for
       Helios/Pegasus in the EmuSen naming scheme, which is where it was built
       before moving here. See docs/Pegasus_Design.md for the design record,
       docs/Pegasus_Format.md for the on-disk format, and docs/Pegasus_Sync.md
       for pairing and the wire protocol.

       The desktop application. It arrived as four projects - core, net, app and
       tests - was collapsed to one on the rule that a project boundary has to
       buy somebody separability they are actually using, and has now given one
       boundary back: EmuSen.Pegasus.Core, because Chariot consumes the wire
       types and a second implementation of them kept in step by hand is worse
       than a package. Everything below this line is still desktop-only - the
       document model, the note format, the socket session and the window - and
       none of it is a server's business. See docs/Pegasus_Design.md §7. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>EmuSen.Pegasus</AssemblyName>
    <RootNamespace>EmuSen.Pegasus</RootNamespace>

    <!-- The APPLICATION's version, and it is deliberately not the core's. This
         repository holds two things that are released separately: the core is a
         package on `core-v*` tags and is already at 0.3.0, while this is the
         desktop program and started at 0.1.0 on a `v*` tag. §7.1 predicted this
         collision and reserved the namespace for it before there was anything
         to put in it, which is why the first application release needed no tag
         scheme invented under time pressure.

         The two numbers will drift apart and that is correct: a protocol change
         forces the core's version, a change to the window forces this one, and
         tying them would make every frame edit look like a new notepad.

         That this now reads 0.3.0, the same as the core, is a COINCIDENCE and
         not a re-tying of the two. The core reached 0.3.0 on the relicence;
         this reached it because 0.2.0 was spent on a release that built three
         platforms and published none - §15.4.

         Like the core's, THE RELEASED VERSION COMES FROM THE TAG: release.yml
         strips the `v` and passes -p:Version, so a `v*` tag decides what the
         binaries call themselves. This number is the default for a local
         `dotnet publish` and is kept in step so the two never disagree - §15.

         0.4.0 is messaging: a saved buddy list, a chat window per
         correspondent, transcripts on disk, and post that waits at a relay
         sealed to a key the relay does not hold. The two numbers agreeing with
         the core's 0.4.0 is a coincidence again -- the core moved because the
         protocol did, and this moved because the window did. What has to agree
         between two installations is the protocol number in Hello, not the
         version on the download, and this release cannot talk to a 0.3.0 one.
         Pegasus_Sync.md §7. -->
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Db.fs" />
    <Compile Include="IdentityStore.fs" />
    <Compile Include="KnownPeers.fs" />
    <!-- Both are stores over the same database and neither knows anything about
         a socket, so they sit up here with the other stores rather than beside
         the relay that fills them. Chats after Friends only for readability;
         they do not reference each other, and deliberately so - forgetting a
         conversation and removing a buddy are separate acts. -->
    <Compile Include="Friends.fs" />
    <Compile Include="Chats.fs" />
    <Compile Include="Servers.fs" />
    <Compile Include="Document.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Relay.fs" />
    <Compile Include="Controller.fs" />
    <Compile Include="Buddies.fs" />
    <!-- After Buddies because Shell wires the two together and this is the
         window Buddies asks for by callback; before Shell because Shell owns
         one slot per correspondent. Buddies deliberately does not reference
         this - it takes a function - so the buddy panel stays testable without
         a window manager. -->
    <Compile Include="Chat.fs" />
    <Compile Include="SignIn.fs" />
    <Compile Include="Shell.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuSen.Pegasus.Core\EmuSen.Pegasus.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identities and pinned peer keys are rows, not files. Microsoft.Data.Sqlite
         alone resolves SQLitePCLRaw 2.1.11 transitively, which carries a known
         high-severity advisory (GHSA-2m69-gcr7-jv3q), the same one that helped
         retire the C# Chariot's stack, so taking it silently here would be
         indefensible. Pinning the 3.0.5 bundle overrides the transitive version
         and a "dotnet list package" vulnerability audit comes back clean.
         EmuSen pins the identical pair for the same reason; keep them in step. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yrs, the Rust Yjs, through its .NET binding. The natives for all three
         desktop platforms ship so a publish for any RID carries libyrs. -->
    <PackageReference Include="YDotNet" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Linux" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.MacOS" Version="0.6.0" />
    <PackageReference Include="YDotNet.Native.Win32" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window, the theme and the bootstrap all come from LunaP, which is
         why Avalonia is not named here - docs/Pegasus_Design.md §8. It is a
         package rather than a ProjectReference because it lives in another
         repository; NuGet.config says where it is found - §7.1. -->
    <PackageReference Include="EmuSen.LunaP" Version="0.6.0" />
  </ItemGroup>

</Project>
