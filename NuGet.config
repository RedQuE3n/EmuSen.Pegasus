<?xml version="1.0" encoding="utf-8"?>
<!-- EmuSen.LunaP arrives as a package rather than as a ProjectReference across
     a repository boundary. `local-packages` is a folder feed, resolved relative
     to this file so it works on any machine; populate it with `dotnet pack` in
     a checkout of https://github.com/RedQuE3n/EmuSen.LunaP, or replace this
     source with a real feed once the package is pushed to one.

         dotnet pack src/EmuSen.LunaP/EmuSen.LunaP.csproj -c Release \
             -o <path>/Pegasus/local-packages

     One package. It used to say "and the two leaves it depends on", because
     LunaP declared EmuSen.Galaxia and EmuSen.Cauldron as hard dependencies and
     both had to be carried here too; it declares Avalonia and nothing else now.

     THE TRAP: NuGet caches by package id AND version, so repacking the toolkit
     at a version already in ~/.nuget/packages does not propagate and the build
     fails on code that was just written. Bump the version, or delete
     ~/.nuget/packages/emusen.lunap first.
     See docs/Pegasus_Design.md §7.1. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="emusen-local" value="local-packages" />
  </packageSources>
</configuration>
