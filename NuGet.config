<?xml version="1.0" encoding="utf-8"?>
<!-- EmuSen.LunaP comes from nuget.org like any other package now. It lives at
     https://github.com/RedQuE3n/EmuSen.LunaP and is published from a tag there.

     This file used to point at a `local-packages/` folder feed, populated by
     `dotnet pack` in another repository, because the toolkit was not on a real
     feed yet. That arrangement carried a trap worth remembering even though it
     is gone: NuGet caches by package id AND version, so repacking at a version
     already restored did not propagate, and the build failed on code that had
     just been written as though it did not exist.

     Kept as an explicit <clear /> plus nuget.org rather than deleted, so a
     stray source in a machine-wide NuGet.config cannot quietly change where a
     dependency of this project comes from. See docs/Pegasus_Design.md §7.1. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
