<?xml version="1.0" encoding="utf-8"?>
<!-- EmuSen.LunaP, and the two leaves it depends on, arrive as packages rather
     than as a ProjectReference across a repository boundary. `local-packages`
     is a folder feed, resolved relative to this file so it works on any
     machine; populate it with `dotnet pack` in EmuSen-Project, or replace this
     source with GitHub Packages once the packages are pushed there.
     See docs/Pegasus_Design.md §7.1. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="emusen-local" value="local-packages" />
  </packageSources>
</configuration>
