bin/
obj/
out/
*.user

# Local workspaces. A .pegasus file is the authoritative replica of somebody's
# notes and must never be committed by accident; the .md projections beside
# them are regenerated, so they are ignored here too. See docs/Pegasus_Format.md.
*.pegasus
workspace/

# The folder feed NuGet.config points at. The packages in it are built from
# EmuSen-Project and are not this repository's to carry.
local-packages/*.nupkg
